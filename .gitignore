# Spring Boot / Java Project .gitignore
# Comprehensive exclusions for binary files, IDE files, and build artifacts

# Compiled Java class files
*.class

# Log files
*.log
logs/
*.out

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files - Binaries
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Maven build artifacts
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
.m2/

# Gradle build artifacts
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Spring Boot specific
*.original
application-*.properties
application-*.yml
# Keep our main config files
!application.yml
!application.properties
!application-docker.yml
!application-test.yml

# IDE Files
## IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

## Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

## NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

## Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# OS Generated Files
## macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

## Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.tmp
*.temp
*.swp
*.swo
*~.nib
local.properties

## Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Runtime and temporary files
*.pid
*.seed
*.pid.lock
temp/
cache/
.cache/

# Test results
TEST*.xml
test-output/
coverage/

# Database files
*.db
*.sqlite
*.sqlite3
h2/

# Security and secrets
*.key
*.pem
*.p12
*.jks
*.keystore
*.truststore
.env
.env.*
secrets/

# Node modules (if using frontend tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
docker-compose.override.yml

# Application specific
uploads/

# Backup files
*.bak
*.backup
*.old
*.orig

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
*.mkv
*.webm

# Applications
*.app
*.exe
/YAML_MIGRATION.md
